
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAnyAdminCreated() {
      return exists(/databases/$(database)/documents/roles_admin);
    }

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    function isClientUser() {
        return request.auth != null && get(/databases/$(database)/documents/staffs/$(request.auth.uid)).data.perfilId == 'cliente';
    }
    
    function getClientContractId() {
        return get(/databases/$(database)/documents/staffs/$(request.auth.uid)).data.contractId;
    }

    // --- Global Collections ---
    
    match /clients/{clientId} {
      allow read: if isAdmin() || (isClientUser() && getClientContractId() == clientId);
      allow write: if isAdmin();
    }
    
    match /staffs/{staffId} {
        allow read: if isAdmin() || isOwner(staffId);
        allow write: if isAdmin();
    }
    
    match /profiles/{profileId} {
        allow read, write: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read, create: if request.auth != null;
      allow update: if isAdmin() || (isClientUser() && get(/databases/$(database)/documents/clients/$(resource.data.client)).id == getClientContractId());
      allow delete: if isAdmin();
    }
    
    match /hazards/{hazardId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /epis/{epiId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /epcs/{epcId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /trainings/{trainingId} {
       allow read: if request.auth != null;
       allow write: if isAdmin();
    }
    
    match /medical_exams/{examId} {
       allow read: if request.auth != null;
       allow write: if isAdmin();
    }

    // --- Client Subcollections ---
    
    match /clients/{clientId}/{collection}/{docId} {
      allow read: if isAdmin() || (isClientUser() && getClientContractId() == clientId);
      allow write: if isAdmin() || (isClientUser() && getClientContractId() == clientId);
    }
    
    match /clients/{clientId}/units/{unitId}/{subCollection}/{subDocId} {
       allow read: if isAdmin() || (isClientUser() && getClientContractId() == clientId);
       allow write: if isAdmin() || (isClientUser() && getClientContractId() == clientId);
    }
    
    match /clients/{clientId}/units/{unitId}/sectors/{sectorId}/{subCollection}/{subDocId} {
       allow read: if isAdmin() || (isClientUser() && getClientContractId() == clientId);
       allow write: if isAdmin() || (isClientUser() && getClientContractId() == clientId);
    }
    
    // --- Admin and System Collections ---

     match /roles_admin/{userId} {
       allow get: if request.auth != null;
       allow list: if isAdmin();
       allow create: if isAdmin() || !isAnyAdminCreated();
       allow update, delete: if isAdmin() && resource != null;
     }
  }
}
