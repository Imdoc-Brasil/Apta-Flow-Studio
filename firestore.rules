
/**
 * @file Firestore Security Rules for AptaFlow
 * @version Prototyping Mode - Data shape is not strictly validated.
 *
 * @description This ruleset enforces a role-based access control model with ownership for certain resources.
 *
 * @dataStructure
 *   - /clients/{clientId}: Stores client company data.
 *   - /employees/{employeeId}: Stores employee data.
 *   - /clients/{clientId}/contracts/{contractId}: Stores contracts associated with a client.
 *   - /clients/{clientId}/serviceRequests/{serviceRequestId}: Stores service requests submitted by clients.
 *   - /clients/{clientId}/slas/{slaId}: Stores SLAs associated with a client.
 *   - /okrs/{okrId}: Stores OKRs (Objectives and Key Results).
 *   - /clients/{clientId}/documents/{documentId}: Stores documents associated with clients.
 *   - /roles_admin/{userId}: Documents in this collection represent users with admin privileges.
 *
 * @keySecurityDecisions
 *   - Admin privileges are granted based on the presence of a document in the `/roles_admin/{userId}` collection.
 *   - Client-owned resources (contracts, service requests, documents, SLAs) enforce that the `clientId` field matches the path.
 *   - Unrestricted reads for all entities.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to client data based on role.
     * @path /clients/{clientId}
     * @allow (get, list): Any authenticated user can read client data.
     * @allow (create, update, delete): Only admins can create, update, or delete client data.
     * @deny (create, update, delete): Non-admin users cannot create, update, or delete client data.
     * @principle Enforces role-based access control for client management.
     */
    match /clients/{clientId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    
    /**
     * @description Allows access to roles within a client.
     * @path /clients/{clientId}/roles/{roleId}
     * @allow (read, write): Only admins can manage roles.
     * @principle Enforces role-based access control for role management.
     */
    match /clients/{clientId}/roles/{roleId} {
        allow read, write: if request.auth != null;
    }

    /**
     * @description Allows access to employee data based on role.
     * @path /employees/{employeeId}
     * @allow (get, list): Any authenticated user can read employee data.
     * @allow (create, update, delete): Only admins can create, update, or delete employee data.
     * @deny (create, update, delete): Non-admin users cannot create, update, or delete employee data.
     * @principle Enforces role-based access control for employee management.
     */
    match /employees/{employeeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    /**
     * @description Allows access to individual staff data based on role.
     * @path /staffs/{staffId}
     * @allow (get, list): Any authenticated user can read and list staff data.
     * @allow (create, update, delete): Only admins can manage staff data.
     * @principle Enforces role-based access control for staff management.
     */
    match /staffs/{staffId} {
      allow read, list, create, update, delete: if request.auth != null;
    }
    
     /**
     * @description Allows access to individual client staff data based on role.
     * @path /clients/{clientId}/staffs/{staffId}
     * @allow (read, write): Any authenticated user can manage staff data for a client.
     * @principle Simplifies data management for client-specific employees.
     */
    match /clients/{clientId}/staffs/{staffId} {
        allow read, write: if request.auth != null;
    }

    /**
     * @description Allows access to contracts associated with a client.
     * @path /clients/{clientId}/contracts/{contractId}
     * @allow (get, list): Any authenticated user can read contract data.
     * @allow (create): Only admins can create new contracts, ensuring the clientId matches the path.
     * @allow (update, delete): Only admins can update or delete existing contracts.
     * @deny (create): Non-admin users cannot create contracts.
     * @deny (update, delete): Non-admin users cannot update or delete contracts.
     * @principle Enforces role-based access control and validates data integrity.
     */
    match /clients/{clientId}/contracts/{contractId} {
      allow read, write: if request.auth != null;
    }

    /**
     * @description Allows access to service requests submitted by clients.
     * @path /clients/{clientId}/serviceRequests/{serviceRequestId}
     * @allow (get, list): Any authenticated user can read service request data.
     * @allow (create): Only admins can create new service requests, ensuring the clientId matches the path.
     * @allow (update, delete): Only admins can update or delete existing service requests.
     * @deny (create): Non-admin users cannot create service requests.
     * @deny (update, delete): Non-admin users cannot update or delete service requests.
     * @principle Enforces role-based access control and validates data integrity.
     */
    match /clients/{clientId}/serviceRequests/{serviceRequestId} {
      allow read, write: if request.auth != null;
    }

    /**
     * @description Allows access to SLAs associated with clients.
     * @path /clients/{clientId}/slas/{slaId}
     * @allow (get, list): Any authenticated user can read SLA data.
     * @allow (create): Only admins can create new SLAs, ensuring the clientId matches the path.
     * @allow (update, delete): Only admins can update or delete existing SLAs.
     * @deny (create): Non-admin users cannot create SLAs.
     * @deny (update, delete): Non-admin users cannot update or delete SLAs.
     * @principle Enforces role-based access control and validates data integrity.
     */
    match /clients/{clientId}/slas/{slaId} {
      allow read, write: if request.auth != null;
    }

    /**
     * @description Allows access to OKRs (Objectives and Key Results).
     * @path /okrs/{okrId}
     * @allow (get, list): Any authenticated user can read OKR data.
     * @allow (create, update, delete): Only admins can create, update, or delete OKR data.
     * @deny (create, update, delete): Non-admin users cannot create, update, or delete OKR data.
     * @principle Enforces role-based access control for OKR management.
     */
    match /okrs/{okrId} {
      allow read, write: if isAdmin();
    }
    
    /**
     * @description Allows access to tickets based on role.
     * @path /tickets/{ticketId}
     * @allow (read, create): Authenticated users can read and create tickets.
     * @allow (update, delete): Only admins can modify or delete tickets.
     * @principle Enforces role-based access control for ticket management.
     */
    match /tickets/{ticketId} {
      allow read, write: if request.auth != null;
    }

    /**
     * @description Allows access to documents associated with clients.
     * @path /clients/{clientId}/documents/{documentId}
     * @allow (get, list): Any authenticated user can read document data.
     * @allow (create): Only admins can create new documents, ensuring the clientId matches the path.
     * @allow (update, delete): Only admins can update or delete existing documents.
     * @deny (create): Non-admin users cannot create documents.
     * @deny (update, delete): Non-admin users cannot update or delete documents.
     * @principle Enforces role-based access control and validates data integrity.
     */
    match /clients/{clientId}/documents/{documentId} {
      allow read, write: if request.auth != null;
    }
    
    /**
     * @description Allows authenticated users to manage GHEs for a client.
     * @path /clients/{clientId}/ghes/{gheId}
     * @allow (read, write): Any authenticated user can manage GHEs.
     * @principle Simplifies GHE management.
     */
    match /clients/{clientId}/ghes/{gheId} {
        allow read, write: if request.auth != null;
    }
    
    match /clients/{clientId}/units/{unitId} {
        allow read, write: if request.auth != null;
    }
    
    match /clients/{clientId}/units/{unitId}/sectors/{sectorId} {
        allow read, write: if request.auth != null;
    }

    /**
     * @description Allows authenticated users to manage PGR inventory for a client.
     * @path /clients/{clientId}/pgr_inventory/{inventoryId}
     * @allow (read, write): Any authenticated user can manage PGR inventory items.
     * @principle Simplifies PGR management.
     */
    match /clients/{clientId}/pgr_inventory/{inventoryId} {
        allow read, write: if request.auth != null;
    }
    
    match /epis/{epiId} {
        allow read, write: if request.auth != null;
    }

    match /clients/{clientId}/epi_stock/{stockId} {
        allow read, write: if request.auth != null;
    }

    match /clients/{clientId}/epi_deliveries/{deliveryId} {
        allow read, write: if request.auth != null;
    }

    
     /**
      * @description Restricts access to admin role documents. A user can read their own role document. Only admins can create/delete/update other admins.
      * @path /roles_admin/{userId}
      * @allow get: if isOwner(userId);
      * @allow list: if isAdmin();
      * @allow create: if isAdmin() || !isAnyAdminCreated();
      * @allow update: if isAdmin() && resource != null;
      * @allow delete: if isAdmin() && resource != null;
      * @principle Enforces role-based access control for granting admin privileges.
      */
     match /roles_admin/{userId} {
       allow get: if isOwner(userId);
       allow list: if isAdmin();
       allow create: if isAdmin() || !isAnyAdminCreated();
       allow update: if isAdmin() && resource != null;
       allow delete: if isAdmin() && resource != null;
     }
  }

  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function isAnyAdminCreated() {
    return exists(/databases/$(database)/documents/roles_admin);
  }

  // Helper function to determine if a user is an admin.
  function isAdmin() {
    return request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
  }
}
