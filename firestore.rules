rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if the user's UID exists in the roles_admin collection
      return request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isClientUser() {
      // Check if the user is a 'cliente' profile
      return request.auth != null && get(/databases/$(database)/documents/staffs/$(request.auth.uid)).data.perfilId == 'cliente';
    }
    
    function getClientContractId() {
      // Get the contractId for a client user
      return get(/databases/$(database)/documents/staffs/$(request.auth.uid)).data.contractId;
    }

    // --- Global Collections ---

    // Any authenticated user can read clients, but only admins can write.
    match /clients/{clientId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Users can read staff info. Only admins or the user themselves can write.
    match /staffs/{staffId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isOwner(staffId);
    }
    
    // Profiles are read-only for most, writable only by admins.
    match /profiles/{profileId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // All authenticated users can create/read tickets.
    // Update is allowed for admins or the client user associated with the ticket's client.
    match /tickets/{ticketId} {
      allow read, create: if request.auth != null;
      allow update: if isAdmin() || (isClientUser() && get(/databases/$(database)/documents/clients/$(resource.data.client)).id == getClientContractId());
      allow delete: if isAdmin();
    }

    // Catalogs are readable by anyone authenticated, writable by admins.
    match /hazards/{hazardId} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /epis/{epiId} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /epcs/{epcId} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /trainings/{trainingId} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /medical_exams/{examId} { allow read: if request.auth != null; allow write: if isAdmin(); }
    
    // --- Client Subcollections ---
    
    // Generic rule for all client subcollections.
    // Access is granted to admins or the specific client user.
    match /clients/{clientId}/{collection}/{docId} {
      allow read, write: if isAdmin() || (isClientUser() && getClientContractId() == clientId);
    }
    
    // Specific rule for sectors collection
    match /clients/{clientId}/units/{unitId}/sectors/{sectorId} {
       allow read, write: if isAdmin() || (isClientUser() && getClientContractId() == clientId);
    }

    // --- Admin and System Collections ---

    match /roles_admin/{userId} {
      allow get: if request.auth != null;
      allow list, update, delete: if isAdmin();
      allow create: if request.auth.uid == userId || isAdmin();
    }

    // --- NEW RULES FROM HANDOFF ---

    // Audit Logs Collection
    match /audit_logs/{logId} {
      // Only admins can read logs
      allow read: if isAdmin();
      
      // Any authenticated user can create logs, but must be for themselves
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userEmail == request.auth.token.email;
      
      // Logs are immutable
      allow update, delete: if false;
    }

    // System Settings Collection
    match /system_settings/{docId} {
      // Any authenticated user can read settings
      allow read: if request.auth != null;
      
      // Only admins can modify settings
      allow write: if isAdmin();
    }
  }
}
