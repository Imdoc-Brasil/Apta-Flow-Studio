
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user of the application.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique ID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the user."
        },
        "displayName": {
          "type": "string",
          "description": "The display name of the user."
        },
        "role": {
          "type": "string",
          "description": "The role of the user, used for access control.",
          "enum": ["superadmin", "admin", "medico", "staff", "cliente"]
        }
      },
      "required": ["uid", "email"]
    },
    "Client": {
      "title": "Client",
      "description": "Represents a client company.",
      "type": "object",
      "properties": {
        "contractId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cnpj": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["Ativo", "Inativo"]
        },
        "responsibleName": {
          "type": "string"
        },
        "responsibleContact": {
          "type": "string"
        }
      },
      "required": ["contractId", "name", "cnpj"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Represents an employee of a client company.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "roleId": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "status": {
          "type": "string",
          "enum": ["Ativo", "Férias", "Desligado"]
        }
      },
      "required": ["id", "name", "clientId"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores public information for each user."
    },
    "/clients/{clientId}": {
      "schema": {
        "$ref": "#/entities/Client"
      },
      "description": "Collection of all client companies."
    },
    "/clients/{clientId}/employees/{employeeId}": {
      "schema": {
        "$ref": "#/entities/Employee"
      },
      "description": "Subcollection for employees of a specific client."
    }
  }
}
